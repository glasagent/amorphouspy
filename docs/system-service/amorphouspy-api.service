[Unit]
Description=amorphouspy API server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=amorphouspy
WorkingDirectory=/home/amorphouspy/amorphouspy/amorphouspy_api
ExecStart=/home/amorphouspy/.pixi/bin/pixi run --frozen -- uvicorn amorphouspy_api.app:app --host 0.0.0.0 --port 443 --log-level info --backlog 100 --timeout-keep-alive 60
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=on-failure
RestartSec=5
# Disable HDF5's file-locking: it uses flock/fcntl which can hang or deadlock
# on networked filesystems, freezing executorlib cache reads.
Environment=HDF5_USE_FILE_LOCKING=FALSE
Environment=EXECUTOR_TYPE=slurm
Environment=SLURM_PARTITION=main_queue
#Environment=SLURM_RUN_TIME_MAX=7200
# Maximum cores per LAMMPS simulation. Set this to the number of cores on a
# node (good for clusters with a slow interconnect) or the per-job core limit
# in your SLURM queue. The API scales down from this when a job is too small to
# use it efficiently (each potential defines a minimum atoms-per-core). The
# default of 4 is only meant for demos; production runs typically want 16-48.
Environment=LAMMPS_MAX_CORES=8
Environment=AMORPHOUSPY_PROJECTS=/net/fileserver1/data_raid/data/amorphouspy_data
Environment=AMORPHOUSPY_VERSION_PROJECTS=0
Environment=API_BASE_URL=https://amorphouspy.example.com
Environment=MCP_HOST=0.0.0.0
#Environment=API_TOKEN=<your-secret-token>

[Install]
WantedBy=multi-user.target
